# Copy to .env and fill in. Never commit .env.

# --- Postgres (docker-compose reads these too) ---
POSTGRES_USER=mandipulse
POSTGRES_PASSWORD=mandipulse
POSTGRES_DB=mandipulse
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://mandipulse:mandipulse@localhost:5432/mandipulse
# Optional: a different container name / port lets a second checkout run its own Postgres
# POSTGRES_CONTAINER=mandipulse-postgres

# --- Secondary source: CEDA Agri Market Data (Ashoka University) ---
CEDA_API_TOKEN=

# --- Daily feed (later): data.gov.in mandi API ---
DATA_GOV_API_KEY=

# --- Geocoding: contact email sent to Nominatim as its email= parameter ---
NOMINATIM_EMAIL=
